{
  "name": "prysm-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build && node --env-file=.env --watch dist/src/server.js",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file=.env dist/src/server.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src tests",
    "format": "prettier --check .",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "node --experimental-strip-types prisma/seed.ts",
    "ingest:slice": "node --experimental-strip-types scripts/ingest-operational-slice.ts",
    "ingest:dataset": "node --experimental-strip-types scripts/ingest-full-dataset.ts",
    "verify:dataset": "node --experimental-strip-types scripts/verify-dataset.ts",
    "verify:integration": "node --experimental-strip-types scripts/verify-integration.ts",
    "verify:chat-ws": "node scripts/verify-chat-ws.mjs",
    "dev:stack": "powershell -ExecutionPolicy Bypass -File scripts/start-local.ps1"
  },
  "prisma": {
    "seed": "node --experimental-strip-types prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.15.0",
    "argon2": "^0.44.0",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.1",
    "helmet": "^8.1.0",
    "jose": "^6.1.0",
    "pino": "^9.9.0",
    "pino-http": "^10.5.0",
    "ws": "^8.21.3",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "@types/supertest": "^6.0.3",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.34.0",
    "prettier": "^3.6.2",
    "prisma": "^6.15.0",
    "supertest": "^7.1.4",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
