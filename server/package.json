{
  "name": "prysm-backend",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=.env src/server.js",
    "build": "node scripts/check-javascript.js",
    "start": "node --env-file=.env src/server.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "node scripts/check-javascript.js",
    "format": "prettier --check src scripts tests docs/*.js package.json",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "node --env-file=.env prisma/seed.js",
    "verify:integration": "node --env-file=.env scripts/verify-integration.js",
    "verify:chat-ws": "node scripts/verify-chat-ws.mjs",
    "db:backup": "node --env-file=.env scripts/backup-database.js",
    "sync:metadata": "node --env-file=.env scripts/sync-metadata.js",
    "verify:phase5": "node --env-file=.env scripts/verify-phase5.js",
    "docs:generate": "node scripts/generate-api-guide.js"
  },
  "prisma": {
    "seed": "node --env-file=.env prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^6.15.0",
    "argon2": "^0.44.0",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.1",
    "helmet": "^8.1.0",
    "jose": "^6.1.0",
    "pino": "^9.9.0",
    "pino-http": "^10.5.0",
    "ws": "^8.21.3",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.2.4",
    "prettier": "^3.6.2",
    "prisma": "^6.15.0",
    "supertest": "^7.1.4",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
